# ============================================================================
# MindEase - Root environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
#   cp .env.example .env
# ============================================================================

# --- Project ---
COMPOSE_PROJECT_NAME=mindease
ENVIRONMENT=development
TIMEZONE=UTC

# --- External port mapping (only what must be reachable from the host) ---
# Databases/intra services are NOT published here; they live on the internal
# Docker network and are not exposed to the public interface.
BACKEND_PORT=8080
# AI-service host port is published to 127.0.0.1 ONLY (dev overlay); in
# production the AI service has no host-published port at all.
AI_SERVICE_PORT=8000
KEYCLOAK_PORT=8081

# --- Authentication / Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-dev-admin
KEYCLOAK_REALM=mindease
KEYCLOAK_CLIENT_ID=mindease-app
KEYCLOAK_FRONTEND_URL=http://localhost:8081

# --- Journal encryption at rest (AES-256-GCM) ---
# Use `openssl rand -base64 48` in production. This sample value is dev-only
# and is rejected outside the dev/test profiles. SHA-256 derives the 256-bit
# key; changing it makes existing journal ciphertext unreadable.
JOURNAL_ENCRYPTION_KEY=change-me-dev-journal-key-0123456789abcdef

# --- Journal media encryption at rest (AES-256-GCM, 1 MiB chunks) ---
# Seals uploaded images, audio and video, and serves them back through the
# backend with a short-lived per-object token. Changing the key makes
# existing media unreadable. Leave blank to store media unencrypted.
MEDIA_ENCRYPTION_KEY=change-me-dev-media-key-0123456789abcdef

# --- Spring Boot (backend) ---
SPRING_PROFILES_ACTIVE=dev
JWT_ISSUER=http://localhost:8081/realms/mindease
JWT_JWKS_URI=http://keycloak:8080/realms/mindease/protocol/openid-connect/certs

# --- AI Service ---
# Gemini is the default LLM provider. Set a real key (from Google AI Studio).
LLM_PROVIDER=gemini
GEMINI_API_KEY=<GEMINI_API_KEY>
GEMINI_MODEL=gemini-3.5-flash
AI_LOG_LEVEL=INFO
# RAG grounding: seeded from the curated knowledge-base (docker compose up
# runs the rag-seed step once Qdrant is healthy). Set false to disable RAG.
RAG_ENABLED=true
# Server-side facial emotion inference (vit_fer_fp16.tflite, ViT-B/16, 7 classes).
# EMOTION_LABELS must stay in the model's own id2label order:
#   anger,disgust,fear,happy,neutral,sad,surprise
# This is NOT the FER2013 order (sad,surprise,neutral at 5-7); reordering
# mislabels three classes with no runtime error. Same set as the Flutter
# client and the Spring backend.
EMOTION_ENABLED=true
EMOTION_MODEL_PATH=app/models/vit_fer_fp16.tflite
EMOTION_MODEL_VERSION=vit-fer-7
EMOTION_CONFIDENCE_THRESHOLD=0.6
EMOTION_MARGIN_THRESHOLD=0.10
EMOTION_NORMALIZATION=mean_std_0.5

# --- Internal AI service <-> backend auth ---
# REQUIRED: a strong, unique shared secret used for the backend's internal
# callback endpoints (X-Internal-Api-Key). The backend fails startup on the
# blank/placeholder value outside the dev/test profiles.
AI_INTERNAL_API_KEY=change-a-strong-random-secret
AI_JOBS_MAX_ATTEMPTS=3
AI_JOBS_CLAIM_TIMEOUT=5m
AI_JOBS_STALE_SWEEP_INTERVAL=60000
BACKEND_INTERNAL_URL=http://backend:8080/api/v1/internal

# --- AI service cross-origin (default: denied) and rate limiting ---
# Local Flutter web/desktop builds talk to the AI service cross-origin from
# localhost; the dev overlay sets a localhost regex automatically. Leave unset
# for production (same-origin behind the reverse proxy, no wildcard CORS).
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# --- Databases / brokers (internal hostnames, no port publish) ---
MONGO_INITDB_ROOT_USERNAME=mindease
MONGO_INITDB_ROOT_PASSWORD=change-me-dev-mongo
MONGO_INITDB_DATABASE=mindease
MONGO_DATABASE=mindease
REDIS_PASSWORD=change-me-dev-redis
RABBITMQ_DEFAULT_USER=mindease
RABBITMQ_DEFAULT_PASS=change-me-dev-rabbit
QDRANT_COLLECTION=mindease_chunks
MINIO_ROOT_USER=mindease
MINIO_ROOT_PASSWORD=change-me-dev-minio

# --- Backend -> infra connection URLs (internal network hostnames) ---
MONGODB_URI=mongodb://mindease:change-me-dev-mongo@mongo:27017/mindease?authSource=admin
REDIS_URI=redis://:change-me-dev-redis@redis:6379
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
QDRANT_URL=http://qdrant:6333
MINIO_URL=http://minio:9090
# Reachable from the app (for Android emulator use http://10.0.2.2:9090).
# In production, use the externally routed HTTPS S3 endpoint.
MINIO_PUBLIC_URL=http://10.0.2.2:9090
MINIO_ACCESS_KEY=mindease
MINIO_SECRET_KEY=change-me-dev-minio
MINIO_BUCKET=mindease-files

# --- Mail / OTP delivery (SendGrid) ---
# SMTP relay used to email password-reset OTPs to REAL inboxes. The bundled
# mailcatcher (docker/mailcatcher, mailcatcher:1025) is kept as a dev fallback:
# comment MAIL_HOST below to use it (inbox at http://localhost:8025).
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=<SENDGRID_API_KEY>
MAIL_FROM=<verified-sender@example.com>
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_HEALTH_ENABLED=false
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false

# --- RabbitMQ Queues ---
RABBITMQ_QUEUE_AI_TASKS=ai_tasks
