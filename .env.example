# MindEase — environment configuration
# Copy this file to `.env` and adjust values as needed:
#   cp .env.example .env

# Host port mapped to the container's nginx (port 80).
WEB_PORT=8080

# Deploy path prefix. Use "/" when served at the domain root,
# or "/mindease/" when served under a sub-path.
WEB_APP_BASE_PATH=/

# Force Flutter to use the Skia renderer for web builds.
FLUTTER_WEB_USE_SKIA=true
