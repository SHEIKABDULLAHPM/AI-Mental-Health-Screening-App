# MindEase AI service - local configuration template
# Copy to `.env` and fill in real values. NEVER commit real secrets.
APP_NAME=mindease-ai
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
AI_LOG_LEVEL=INFO

# LLM provider (gemini | openai). Gemini is the default.
LLM_PROVIDER=gemini
GEMINI_API_KEY=<GEMINI_API_KEY>
GEMINI_MODEL=gemini-3.5-flash

# Cross-origin access. Unset by default (= DENIED, no wildcard). For local
# Flutter web/desktop builds that reach the AI service directly, set a regex
# such as: ^(http://localhost|http://127\.0\.0\.1)(:\d+)?$
CORS_ALLOW_ORIGINS=
CORS_ALLOW_ORIGIN_REGEX=

# Rate limiting for the unauthenticated /api/v1 endpoints
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# Backend callback (internal endpoints). AI_INTERNAL_API_KEY must exactly match
# the backend's AI_INTERNAL_API_KEY - there is no fallback default.
BACKEND_INTERNAL_URL=http://backend:8080/api/v1/internal
AI_INTERNAL_API_KEY=change-a-strong-random-secret

# RAG / Qdrant. The knowledge-base is seeded via the compose `rag-seed` step
# (scripts/seed_vectors.py). Set RAG_ENABLED=false to disable RAG explicitly.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=mindease_chunks
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_ENABLED=true

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=mindease
RABBITMQ_PASSWORD=change-me-dev-rabbit
AI_TASKS_QUEUE=ai_tasks

# Redis cache
REDIS_URI=redis://:change-me-dev-redis@localhost:6379