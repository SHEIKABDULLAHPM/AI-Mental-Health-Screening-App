# ============================================================================
# MindEase - Root environment template
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
#   cp .env.example .env
# ============================================================================

# --- Project ---
COMPOSE_PROJECT_NAME=mindease
ENVIRONMENT=development
TIMEZONE=UTC

# --- External port mapping (only what must be reachable from the host) ---
# Databases/intra services are NOT published here; they live on the internal
# Docker network and are not exposed to the public interface.
BACKEND_PORT=8080
AI_SERVICE_PORT=8000
KEYCLOAK_PORT=8081

# --- Authentication / Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-dev-admin
KEYCLOAK_REALM=mindease
KEYCLOAK_CLIENT_ID=mindease-app
KEYCLOAK_FRONTEND_URL=http://localhost:8081

# --- Spring Boot (backend) ---
SPRING_PROFILES_ACTIVE=dev
JWT_ISSUER=http://localhost:8081/realms/mindease
JWT_JWKS_URI=http://keycloak:8080/realms/mindease/protocol/openid-connect/certs

# --- AI Service ---
OPENAI_API_KEY=sk-change-me
OPENAI_MODEL=gpt-4o-mini
AI_LOG_LEVEL=INFO

# --- Databases / brokers (internal hostnames, no port publish) ---
MONGO_INITDB_ROOT_USERNAME=mindease
MONGO_INITDB_ROOT_PASSWORD=change-me-dev-mongo
MONGO_INITDB_DATABASE=mindease
MONGO_DATABASE=mindease
REDIS_PASSWORD=change-me-dev-redis
RABBITMQ_DEFAULT_USER=mindease
RABBITMQ_DEFAULT_PASS=change-me-dev-rabbit
QDRANT_COLLECTION=mindease_chunks
MINIO_ROOT_USER=mindease
MINIO_ROOT_PASSWORD=change-me-dev-minio

# --- Backend -> infra connection URLs (internal network hostnames) ---
MONGODB_URI=mongodb://mindease:change-me-dev-mongo@mongo:27017/mindease?authSource=admin
REDIS_URI=redis://:change-me-dev-redis@redis:6379
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/
QDRANT_URL=http://qdrant:6333
MINIO_URL=http://minio:9000
MINIO_ACCESS_KEY=mindease
MINIO_SECRET_KEY=change-me-dev-minio
MINIO_BUCKET=mindease-files

# --- RabbitMQ Queues ---
RABBITMQ_QUEUE_AI_TASKS=ai_tasks